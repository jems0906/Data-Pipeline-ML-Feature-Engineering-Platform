{
  "name": "ml-feature-platform-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:esbuild": "if not exist %TEMP%\\esbuild.exe copy /Y .\\node_modules\\@esbuild\\win32-x64\\esbuild.exe %TEMP%\\esbuild.exe >NUL",
    "dev": "npm run prepare:esbuild && set \"ESBUILD_BINARY_PATH=%TEMP%\\esbuild.exe\" && node ./node_modules/vite/bin/vite.js",
    "build": "npm run prepare:esbuild && set \"ESBUILD_BINARY_PATH=%TEMP%\\esbuild.exe\" && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.52.4"
  }
}
