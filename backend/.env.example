APP_NAME=Data Pipeline & ML Feature Engineering Platform
ENVIRONMENT=dev
API_PREFIX=/api/v1
POSTGRES_URL=postgresql+psycopg://platform:platform@localhost:5433/feature_platform
REDIS_URL=redis://localhost:6380/0
BIGQUERY_PROJECT=
BIGQUERY_CREDENTIALS_PATH=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
RAW_DIR=../data/raw
PROCESSED_DIR=../data/processed
EXPORTS_DIR=../data/exports
METADATA_DIR=../data/metadata
DEFAULT_TRAIN_RATIO=0.8
OUTLIER_ZSCORE_THRESHOLD=3.0
MISSING_RATE_ALERT_THRESHOLD=0.2
OUTLIER_RATE_ALERT_THRESHOLD=0.1
DEFAULT_FRESHNESS_LAG_SECONDS=3600
ALERT_CHANNELS_CSV=slack://data-platform-alerts,email://ml-ops@company.com
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_SENDER=
ALERT_DISPATCH_TIMEOUT_SECONDS=10
